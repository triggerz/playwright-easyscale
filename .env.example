# Authentication
AUTH_SECRET=your-secret-passphrase-here

# Railway Configuration
RAILWAY_API_TOKEN=your-railway-api-token
RAILWAY_PROJECT_ID=your-project-id
RAILWAY_SERVICE_ID=your-worker-service-id

# S3-Compatible Storage (Railway Buckets or AWS S3)
S3_ENDPOINT=https://your-bucket-endpoint
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=auto

# Server Configuration
PORT=3000

# CORS Configuration (URL of the web-ui for CORS)
WEB_UI_URL=http://localhost:5173
